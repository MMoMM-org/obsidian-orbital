{
	"name": "orbital",
	"version": "1.3.0",
	"description": "Orbital plugin.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:live": "vitest run --config vitest.live.config.ts",
		"lint": "eslint src/ && stylelint styles.css",
		"lint:css": "stylelint styles.css",
		"lint:fix": "eslint src/ --fix && stylelint styles.css --fix",
		"audit": "npm audit --audit-level=high --omit=dev"
	},
	"keywords": [],
	"license": "MIT",
	"browserslist": [
		"chrome 114"
	],
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "9.39.4",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@types/node": "^26.5.1",
		"conventional-changelog-conventionalcommits": "^10.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"semantic-release": "^25.0.9",
		"stylelint": "^17.15.0",
		"stylelint-no-unsupported-browser-features": "^8.1.2",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"obsidian": ">=1.5.7"
	}
}
